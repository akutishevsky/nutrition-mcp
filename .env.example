# Railway PostgreSQL. In Railway, set this as a reference to the PostgreSQL
# service's DATABASE_URL variable.
DATABASE_URL=postgresql://postgres:password@localhost:5432/munch
MUNCH_DB_POOL_SIZE=10

# Public origin used for account, billing, OAuth, and callback URLs.
MUNCH_APP_BASE_URL=http://localhost:8080

# Long random secret reserved for signed account/session state. Generate at least
# 32 random bytes and do not reuse OAuth or Stripe secrets.
MUNCH_SESSION_SECRET=replace-with-a-long-random-secret

# Passwordless login delivery. The endpoint receives a signed server-to-server
# POST containing { email, loginUrl, expiresAt, product }. It must use HTTPS in
# production. The secret is sent as a Bearer token.
MUNCH_LOGIN_DELIVERY_ENDPOINT=
MUNCH_LOGIN_DELIVERY_SECRET=

# Local development only. Never enable in production: it returns the magic link
# in the login-request response instead of sending it through a delivery service.
MUNCH_DEV_EXPOSE_LOGIN_LINK=false

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me

# Temporary upstream compatibility. These variables remain required until the
# inherited Supabase repository and authentication implementation are fully
# replaced by the Railway PostgreSQL adapters.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret

# Google login is inherited and optional. Munch's Railway-native identity uses
# passwordless email; this integration will be removed or redesigned.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Open Food Facts requires an identifying User-Agent in the form
# "AppName (contact)".
OFF_USER_AGENT=Munch (you@example.com)

# USDA FoodData Central integration is added in a later provider PR.
USDA_FDC_API_KEY=replace-me

PORT=8080
