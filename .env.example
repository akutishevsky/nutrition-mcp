# Railway PostgreSQL. In Railway, reference the PostgreSQL service variable.
DATABASE_URL=postgresql://postgres:password@localhost:5432/munch
MUNCH_DB_POOL_SIZE=10

# Public origin used for account, billing, OAuth, exports, and callbacks.
MUNCH_APP_BASE_URL=http://localhost:8080

# Backends must change together. Better Auth additionally requires both Railway
# flags to be true so authentication UUIDs and nutrition UUIDs remain coherent.
MUNCH_RAILWAY_AUTH_ENABLED=false
MUNCH_RAILWAY_DATA_ENABLED=false

# Enable only for the controlled production cutover after staging reports ready.
MUNCH_STRICT_STARTUP_VALIDATION=false

# Authentication implementation. Keep `custom` until Better Auth magic-link,
# Stripe, OAuth, refresh, revocation, and live MCP certification pass in staging.
MUNCH_AUTH_BACKEND=custom

# Legacy custom-auth rollback secret. Required only while MUNCH_AUTH_BACKEND is
# `custom`; retain it during the Better Auth rollback window.
MUNCH_SESSION_SECRET=replace-with-a-long-random-secret

# Better Auth core. Generate at least 32 random bytes and do not reuse Stripe,
# email-delivery, database, or legacy session secrets.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
MUNCH_AUTH_DB_POOL_SIZE=5
MUNCH_MAGIC_LINK_TTL_SECONDS=600

# Better Auth transactional magic-link delivery. The endpoint receives a
# server-to-server POST containing email, from, loginUrl, expiresAt, product,
# and template. Disable click tracking and link rewriting at the email provider.
MUNCH_EMAIL_DELIVERY_ENDPOINT=
MUNCH_EMAIL_DELIVERY_SECRET=
MUNCH_EMAIL_FROM=Munch <support@example.com>

# Legacy custom-auth email delivery. Required only while the custom backend is
# enabled during migration or rollback.
MUNCH_LOGIN_DELIVERY_ENDPOINT=
MUNCH_LOGIN_DELIVERY_SECRET=

# Local development only. Never enable in production.
MUNCH_DEV_EXPOSE_LOGIN_LINK=false

# Stripe Billing: one Munch Premium price at $4.99/month. Checkout currently
# includes the configured seven-day trial and Customer Portal manages billing.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me

# Inherited rollback backend. Required only while both Railway flags are false.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Open Food Facts requires an identifying User-Agent in the form
# "AppName (contact)".
OFF_USER_AGENT=Munch (you@example.com)

# USDA FoodData Central provider.
USDA_FDC_API_KEY=replace-me

PORT=8080
