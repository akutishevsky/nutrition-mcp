# Railway PostgreSQL. In Railway, reference the PostgreSQL service variable.
DATABASE_URL=postgresql://postgres:password@localhost:5432/munch
MUNCH_DB_POOL_SIZE=10

# Public origin used for account, billing, OAuth, exports, and callbacks.
MUNCH_APP_BASE_URL=http://localhost:8080

# Backends must change together. Keep both false until Railway staging has passed
# live MCP registration, OAuth, subscription, write, refresh, and reconnect tests.
MUNCH_RAILWAY_AUTH_ENABLED=false
MUNCH_RAILWAY_DATA_ENABLED=false

# Enable only for the controlled Railway production cutover after /health/ready
# reports ready. When true, invalid production configuration blocks startup.
MUNCH_STRICT_STARTUP_VALIDATION=false

# Long random secret reserved for account/session state. Generate at least 32
# random bytes and do not reuse OAuth, Stripe, or login-delivery secrets.
MUNCH_SESSION_SECRET=replace-with-a-long-random-secret


# Authentication implementation. Keep `custom` until the Better Auth staging
# certification matrix has passed, then switch the exact certified release.
MUNCH_AUTH_BACKEND=custom
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
MUNCH_AUTH_DB_POOL_SIZE=5
MUNCH_MAGIC_LINK_TTL_SECONDS=600

# Better Auth transactional magic-link delivery. During migration, the runtime
# can fall back to the legacy MUNCH_LOGIN_DELIVERY_* values, but production
# should configure these explicit variables.
MUNCH_EMAIL_DELIVERY_ENDPOINT=
MUNCH_EMAIL_DELIVERY_SECRET=
MUNCH_EMAIL_FROM=

# Passwordless login delivery. Munch sends a server-to-server POST containing
# { email, loginUrl, expiresAt, product }. Production endpoints must use HTTPS.
MUNCH_LOGIN_DELIVERY_ENDPOINT=
MUNCH_LOGIN_DELIVERY_SECRET=

# Local development only. Never enable in production.
MUNCH_DEV_EXPOSE_LOGIN_LINK=false

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me

# Inherited rollback backend. Required only while both Railway flags are false.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Open Food Facts requires an identifying User-Agent in the form
# "AppName (contact)".
OFF_USER_AGENT=Munch (you@example.com)

# USDA FoodData Central provider.
USDA_FDC_API_KEY=replace-me

PORT=8080
