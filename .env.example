SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret

# Google login (optional). When unset, only email/password sign-in is available.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Open Food Facts requires a User-Agent identifying your app + contact, in the
# form "AppName (email)". Used for barcode lookups (lookup_barcode tool).
OFF_USER_AGENT=nutrition-mcp (you@example.com)

PORT=8080

# Patreon
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CAMPAIGN_ID=
PATREON_ACCESS_TOKEN=
PATREON_REFRESH_TOKEN=

# (optional) Any non-empty value sends X-Robots-Tag: noindex, nofollow on every response and leaves Google Analytics and Clarity out of the generated pages, for a dev or staging deploy. Must be set at build time too, since the pages are generated during the build
NOINDEX=