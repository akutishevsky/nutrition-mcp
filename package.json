{
    "name": "munch-mcp",
    "version": "0.1.0",
    "description": "A privacy-conscious nutrition tracking MCP service for ChatGPT and other MCP clients.",
    "author": "Munch contributors",
    "license": "MIT",
    "homepage": "https://github.com/michaelhmiv/Munch",
    "repository": {
        "type": "git",
        "url": "https://github.com/michaelhmiv/Munch.git"
    },
    "keywords": [
        "mcp",
        "nutrition",
        "meal-tracking",
        "chatgpt",
        "model-context-protocol"
    ],
    "module": "index.ts",
    "type": "module",
    "private": true,
    "devDependencies": {
        "@types/bun": "latest",
        "@types/node": "^26.1.2",
        "@typescript/native-preview": "7.0.0-dev.20260707.2"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "scripts": {
        "start": "bun src/index.ts",
        "dev": "bun --watch src/index.ts",
        "test": "bun test",
        "db:migrate": "bun scripts/migrate.ts",
        "maintenance": "bun scripts/maintenance.ts",
        "inspect": "bunx @modelcontextprotocol/inspector",
        "harness": "bun run scripts/widget-harness.ts",
        "format": "bunx prettier --write .",
        "format:check": "bunx prettier --check .",
        "typecheck": "bun run scripts/typecheck.ts",
        "brand:check": "bun run scripts/brand-check.ts",
        "generate-oauth-creds": "echo \"OAUTH_CLIENT_ID=$(openssl rand -hex 16)\" && echo \"OAUTH_CLIENT_SECRET=$(openssl rand -hex 32)\""
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@supabase/supabase-js": "^2.110.5",
        "hono": "^4.12.30",
        "prettier": "^3.9.5",
        "zod": "3.25.76"
    }
}
