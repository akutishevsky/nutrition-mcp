{
    "name": "munch-mcp",
    "version": "0.1.0",
    "description": "A privacy-conscious nutrition tracking MCP service for ChatGPT and other MCP clients.",
    "author": "Munch contributors",
    "license": "MIT",
    "homepage": "https://github.com/michaelhmiv/Munch",
    "repository": {
        "type": "git",
        "url": "https://github.com/michaelhmiv/Munch.git"
    },
    "keywords": [
        "mcp",
        "nutrition",
        "meal-tracking",
        "chatgpt",
        "model-context-protocol"
    ],
    "module": "index.ts",
    "type": "module",
    "private": true,
    "devDependencies": {
        "@capacitor/cli": "8.5.0",
        "@playwright/test": "^1.64.0",
        "@types/bun": "latest",
        "@types/node": "^26.1.2",
        "@types/pg": "8.15.5",
        "@typescript/native-preview": "7.0.0-dev.20260707.2"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "scripts": {
        "start": "bun src/index.ts",
        "dev": "bun --watch src/index.ts",
        "test": "bun test",
        "test:e2e": "playwright test",
        "test:e2e:mobile": "playwright test --config playwright.mobile.config.ts",
        "db:migrate": "bun scripts/migrate.ts",
        "maintenance": "bun scripts/maintenance.ts",
        "inspect": "bunx @modelcontextprotocol/inspector",
        "harness": "bun run scripts/widget-harness.ts",
        "format": "bunx prettier --write .",
        "format:check": "bunx prettier --check .",
        "typecheck": "bun run scripts/typecheck.ts",
        "brand:check": "bun run scripts/brand-check.ts",
        "icons:generate": "python3 scripts/generate-app-icons.py",
        "commerce:check": "bun scripts/commerce-boundary-check.ts",
        "submission:generate": "bun scripts/generate-openai-submission.ts",
        "submission:audit": "bun scripts/openai-submission-audit.ts",
        "submission:check": "bun scripts/openai-submission-audit.ts && bun scripts/policy-consistency-check.ts && bun scripts/widget-csp-audit.ts && bun scripts/generate-openai-submission.ts --check",
        "auth:schema": "bunx auth@1.6.25 generate --config src/auth/auth.ts --output .better-auth-schema.sql --yes",
        "mobile:web": "bun scripts/build-mobile-web.ts",
        "mobile:sync": "bun run mobile:web && npx cap sync",
        "mobile:android": "bun run mobile:web && npx cap sync android",
        "mobile:android:debug": "bun run mobile:android && cd android && ./gradlew assembleDebug"
    },
    "dependencies": {
        "@better-auth/oauth-provider": "1.6.25",
        "@capacitor/android": "8.5.0",
        "@capacitor/app": "8.1.1",
        "@capacitor/barcode-scanner": "3.1.1",
        "@capacitor/camera": "8.2.3",
        "@capacitor/core": "8.5.0",
        "@capacitor/ios": "8.5.0",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "better-auth": "1.6.25",
        "cheerio": "1.2.0",
        "hono": "^4.12.30",
        "node-wreq": "3.1.0",
        "pg": "8.16.3",
        "prettier": "^3.9.5",
        "zod": "3.25.76"
    }
}
